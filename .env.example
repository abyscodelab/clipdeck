# === ClipDeck Configuration ===

# Security (REQUIRED - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CLIPDECK_MASTER_KEY=change-me-generate-a-real-fernet-key
JWT_SECRET=change-me-to-a-random-string

# Database (Supports sqlite:/// or sqlite+aiosqlite:///, or Supabase PostgreSQL)
DATABASE_URL=sqlite:///./data/clipdeck.db

# === Supabase Configuration (Cloud Database & Storage) ===
# Direct Supabase PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.gwzcoxeddnyvsolvzsgv.supabase.co:5432/postgres
# Or Session/Transaction Pooler URL:
# DATABASE_URL=postgresql://postgres.gwzcoxeddnyvsolvzsgv:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase API Keys
SUPABASE_URL=https://gwzcoxeddnyvsolvzsgv.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh... (Find in Supabase Dashboard > Project Settings > API)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd3emNveGVkZG55dnNvbHZ6c2d2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUxMTc5NjYsImV4cCI6MjExMDY5Mzk2Nn0.w9nP7cHFHZtNAPJFMvpvsKB9fMTxtmhiE13IV6ZP4c8
SUPABASE_STORAGE_BUCKET_CLIPS=clips
SUPABASE_STORAGE_BUCKET_THUMBNAILS=thumbnails
USE_SUPABASE_STORAGE=true

# Redis
REDIS_URL=redis://redis:6379/0

# Media Storage
MEDIA_PATH=/data/media
RING_BUFFER_MAX_MINUTES=15
RING_BUFFER_DISK_CAP_GB=50

# Domain (for production HTTPS)
DOMAIN=clipdeck.example.com

# Worker
MAX_CONCURRENT_STREAMS=4

# Default admin credentials (change on first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# === Phase 2: AI Providers & Daily Spend Caps ===

# Provider API Keys (Can also be set in Settings UI, encrypted at rest via Fernet)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPGRAM_API_KEY=...

# Default AI Model Routing
AI_SCORING_PROVIDER=gemini
AI_SCORING_MODEL=gemini-2.5-flash
AI_EDL_PROVIDER=anthropic
AI_EDL_MODEL=claude-3-5-sonnet-20241022
AI_TITLES_PROVIDER=openai
AI_TITLES_MODEL=gpt-4o-mini
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_MODEL=nova-2

# Cost & Spend Controls
DAILY_SPEND_CAP_DOLLARS=15.00
MONTHLY_SPEND_CAP_DOLLARS=150.00
ENABLE_HARD_BUDGET_CAP=true

# === Platform API Keys (configure in Settings UI after first login) ===

# Twitch (https://dev.twitch.tv/console)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_BOT_TOKEN=

# Kick (https://kick.com/developer)
# KICK_APP_ID=
# KICK_API_KEY=
# KICK_WEBHOOK_SECRET=

# YouTube / Google (https://console.cloud.google.com)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# === Publishing (Phase 4, configure in Settings UI) ===
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Notifications (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
