{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subtle-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "subtle.refs.video", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/demo/*", "/ingest/*"]
  }
}
